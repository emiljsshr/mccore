# Copy to .env for local development. In production this file's installed
# equivalent is /etc/mccore/mccore.env (mode 600, owner mccore) — see
# installer/install.sh.

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://mccore:mccore@127.0.0.1:5432/mccore?schema=public"

# --- Control Plane --------------------------------------------------------
CONTROL_PLANE_PORT=4000
CONTROL_PLANE_URL="http://127.0.0.1:4000"
PUBLIC_URL="http://localhost:3000"
LOG_LEVEL="info"
NODE_ENV="development"

# 64-byte random secret used to sign short-lived internal tokens (not
# session tokens, which are DB-backed opaque values — see docs/security.md).
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-generate-with-openssl-rand-hex-32"

# 32-byte key (base64) used for AES-256-GCM encryption of TOTP secrets at
# rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-generate-with-openssl-rand-base64-32"

# --- Storage --------------------------------------------------------------
STORAGE_PATH="./.data/servers"
BACKUP_PATH="./.data/backups"
AGENT_STATE_PATH="./.data/agent"

# --- Local agent (dev convenience; production uses the systemd unit) -----
AGENT_NODE_NAME="Local Node"
